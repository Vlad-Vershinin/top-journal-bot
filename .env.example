# Получить у @BotFather
TELEGRAM_BOT_TOKEN=

# Необязательно. Нужен, если сервер не может подключиться к api.telegram.org.
# Поддерживаются HTTP и SOCKS5; логин/пароль должны быть URL-encoded.
# Примеры:
# TELEGRAM_PROXY_URL=http://user:password@proxy.example.com:3128
# TELEGRAM_PROXY_URL=socks5://user:password@proxy.example.com:1080
TELEGRAM_PROXY_URL=

# Данные для входа в Journal
JOURNAL_USERNAME=
JOURNAL_PASSWORD=

# Необязательно: ограничить бота одним Telegram-пользователем.
# Узнать ID можно командой /id после первого запуска.
ALLOWED_TELEGRAM_USER_ID=

# Chat ID для ежедневной автоматической отправки.
# Для личного чата обычно совпадает с user ID.
NOTIFICATION_CHAT_ID=
NOTIFICATION_TIME=07:30
TIMEZONE=Asia/Yekaterinburg

# Обычно менять не требуется
JOURNAL_API_URL=https://msapi.top-academy.ru/api/v2
REQUEST_TIMEOUT_SECONDS=20

# Логи ротируются ежедневно и автоматически удаляются через 14 дней.
LOG_DIR=logs
LOG_LEVEL=INFO

# Последнее успешное расписание для работы при падении сайта.
CACHE_FILE=data/schedule_cache.json
